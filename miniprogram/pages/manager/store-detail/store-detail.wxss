/* pages/manager/store-detail/store-detail.wxss — v1.0.3 老板拍板三 tab + 录入消耗购物车复用 */
/* 顶部 tab：① 库存 / ② 录入消耗 / ③ 历史消耗 */
.rq-tabs {
  display: flex;
  gap: 16rpx;
}
.rq-tab {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--gray-light);
  color: var(--gray);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  cursor: pointer;
  user-select: none;
}
.rq-tab-active {
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(176, 58, 46, 0.25);
}

/* 录入消耗 tab 用的菜品行（复用 食材申请 样式） */
.mr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #efece5;
}
.mr-row:last-child { border-bottom: none; }
.mr-main { flex: 1; min-width: 0; }
.mr-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.mr-sub { font-size: 22rpx; color: var(--gray); margin-top: 4rpx; }
.mr-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.mr-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 12rpx;
}
.mr-qty {
  width: 96rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  background: var(--gray-light);
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 0;
}
.mr-btn-sm { width: 48rpx; height: 48rpx; line-height: 48rpx; font-size: 32rpx; }
.mr-qty-sm { width: 80rpx; height: 48rpx; line-height: 48rpx; font-size: 26rpx; }

/* 购物车弹层（复用全局 .ip-mask / .ip-panel 居中弹层 + 自有 cart-panel） */
.cart-panel { /* 继承 .ip-panel 70% 宽 + 55vh + 居中 */ }
.cart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.cart-row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cart-row-sub { font-size: 22rpx; color: var(--gray); margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cart-row-ctrl { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.cart-row-del { color: var(--danger); font-size: 24rpx; padding: 0 8rpx; flex-shrink: 0; }
.cart-footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #efece5;
}
.cart-footer .cb-btn { flex: 1; }
.cb-btn-ghost {
  background: var(--gray-light);
  color: var(--primary);
}

/* 购物车浮条（复用 食材申请 样式） */
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  background: var(--primary);
  color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(176, 58, 46, 0.35);
  z-index: 998;
}
.cart-bar-info { flex: 1; display: flex; align-items: baseline; gap: 8rpx; min-width: 0; }
.cart-bar-label { font-size: 30rpx; font-weight: 600; }
.cart-bar-count { font-size: 30rpx; opacity: 0.85; }
.cart-bar-actions { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; }
.cb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  cursor: pointer;
  user-select: none;
}
.cb-btn-primary {
  background: #ffffff;
  color: var(--primary);
}
.cb-btn-disabled {
  background: rgba(255, 255, 255, 0.45);
  color: rgba(255, 255, 255, 0.85);
  pointer-events: none;
}

/* ① 库存 tab：本店预警阈值（2026-10-09）
   ⚠️ 不能复用 .cb-btn-primary —— 那是给底部深色购物车浮条设计的（白底 + 主色字），
      放在白卡片上会「白底白字」看不见，故这里单独一套浅色主色按钮。 */
.th-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 12rpx;
}
.th-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
}
.th-save {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: var(--primary);
  color: #ffffff;
  cursor: pointer;
  user-select: none;
}
.th-save.th-save-disabled {
  background: rgba(176, 58, 46, 0.45);
  pointer-events: none;
}

/* ③ 历史消耗 tab：日期分组标题 */
.his-date {
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 500;
  margin: 20rpx 0 8rpx;
}
.his-date:first-child { margin-top: 8rpx; }

/* 消耗明细弹层（复用全局 .ip-mask / .ip-panel；双类名提特异性覆盖宽度） */
.ip-panel.detail-panel {
  width: 82%;
  max-height: 76vh;
  overflow-y: auto;
}
.detail-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.detail-label { font-size: 26rpx; color: var(--gray); }
.detail-val { font-size: 28rpx; color: var(--text); font-weight: 500; }
.detail-sep { height: 1rpx; background: #efece5; margin: 16rpx 0; }
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #efece5;
}
.detail-item:last-child { border-bottom: none; }
.detail-item-name { font-size: 28rpx; color: var(--text); }
.detail-item-qty { font-size: 28rpx; color: var(--primary); font-weight: 600; }

/* ① 库存校准弹层（2026-10-08 老板反馈「文字不清晰、排版有问题」重做）：
   食材名做主标题大字 + 库存/阈值两格并排 + 两个独立小节 + 按钮铺满一行 */
.calib-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
}
.calib-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.calib-stat {
  flex: 1;
  background: var(--gray-light);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}
.calib-stat-k {
  font-size: 22rpx;
  color: var(--gray);
}
.calib-stat-v {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 4rpx;
}
.calib-sec {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin: 28rpx 0 12rpx;
}
.calib-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--gray);
  margin-top: 4rpx;
}
.calib-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  background: var(--gray-light);
  border-radius: 12rpx;
  font-size: 30rpx;
}
.calib-tip {
  font-size: 22rpx;
  color: var(--gray);
  line-height: 1.6;
  margin-top: 10rpx;
}
.calib-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.calib-btns .cb-btn { flex: 1; height: 84rpx; }
/* 弹层在白色面板上，不能用购物车浮条那套白底主色字（会白底白字） */
.calib-cancel { background: var(--gray-light); color: var(--text); }
.calib-save { background: var(--primary); color: #ffffff; }
.calib-save.calib-save-disabled { background: rgba(176, 58, 46, 0.45); pointer-events: none; }