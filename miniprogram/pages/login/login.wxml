<view class="page">
  <view class="card" style="text-align:center; padding:48rpx 24rpx;">
    <view style="font-size:44rpx; font-weight:700; color:var(--primary)">王婆婆家常菜</view>
    <view class="sub" style="margin-top:8rpx">仓库与重要食材管理系统</view>
  </view>

  <!-- 账号密码登录（默认，退出登录后也回到这里） -->
  <view wx:if="{{state === 'login'}}" class="card">
    <view class="card-title">账号登录</view>
    <view class="field">
      <label class="field-label">账号</label>
      <input class="input" value="{{username}}" bindinput="onUsername" placeholder="例：888" />
    </view>
    <view class="field">
      <label class="field-label">密码</label>
      <view class="pwd-wrap">
        <input class="input pwd-input" password="{{!showPwd}}" value="{{password}}" bindinput="onPassword" placeholder="请输入密码" />
        <text class="pwd-eye" bindtap="togglePwd">{{showPwd ? '🙈' : '👁'}}</text>
      </view>
    </view>
    <button class="btn btn-primary" bindtap="doLogin" disabled="{{loading}}">登 录</button>
    <button class="btn btn-ghost" style="margin-top:16rpx" bindtap="goRegister">注册开店（门店端）</button>
    <view class="hint">以账号为准：账号 + 密码登录，不绑定微信。同一账号可在不同手机登录。想改密码请到「我的」页。</view>
  </view>

  <!-- 注册开店 -->
  <view wx:elif="{{state === 'register'}}" class="card">
    <view class="card-title">注册开店</view>
    <view class="sub">一键建店建号，注册成功直接进入门店端</view>
    <view class="field">
      <label class="field-label">门店名称</label>
      <input class="input" value="{{shopName}}" bindinput="onShopName" placeholder="例：万达店" />
    </view>
    <view class="field">
      <label class="field-label">登录账号（3–20 位字母/数字/下划线）</label>
      <input class="input" value="{{regUsername}}" bindinput="onRegUsername" placeholder="例：wanda" />
    </view>
    <view class="field">
      <label class="field-label">登录密码（至少 6 位）</label>
      <view class="pwd-wrap">
        <input class="input pwd-input" password="{{!showRegPwd}}" value="{{regPassword}}" bindinput="onRegPassword" placeholder="请输入密码" />
        <text class="pwd-eye" bindtap="toggleRegPwd">{{showRegPwd ? '🙈' : '👁'}}</text>
      </view>
    </view>
    <button class="btn btn-primary" bindtap="doRegister" disabled="{{loading}}">注册开店并进入门店端</button>
    <button class="btn btn-ghost" style="margin-top:16rpx" bindtap="backToLogin">返回登录</button>
    <view class="hint">账号全局唯一；注册后用「账号 + 密码」登录，与微信无关。</view>
  </view>
</view>
