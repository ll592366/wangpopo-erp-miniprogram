/* ==========================================================================
 * app.wxss — 全局样式 + 设计 token（原生 WXSS，无第三方依赖）
 * 色板：主色 #b03a2e（家常菜红）· 辅色 #2e7d52（正常绿）· 警示 #c77700 · 危险 #c0392b
 * ========================================================================== */
page {
  --primary: #b03a2e;
  --primary-light: #f7e9e7;
  --ok: #2e7d52;
  --ok-light: #e8f4ed;
  --warn: #c77700;
  --warn-light: #fdf3e3;
  --danger: #c0392b;
  --danger-light: #fdeceb;
  --gray: #8a8a8a;
  --gray-light: #f0efec;
  --text: #333333;
  --text-sub: #777777;
  background: #f6f5f2;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---------- 通用容器 ---------- */
.page { padding: 24rpx; padding-bottom: 60rpx; }
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; color: var(--text); }
.sub { font-size: 24rpx; color: var(--text-sub); margin-bottom: 16rpx; }

/* ---------- 表单 ---------- */
.field { margin-bottom: 20rpx; }
.field-label { font-size: 24rpx; color: var(--text-sub); margin-bottom: 8rpx; display: block; }
/* 只读但可点（如"档案未填规格 · 去补"）：提示可跳转（双类名，压过 .readonly 的灰色） */
.input.readonly-tap { color: var(--warn); text-decoration: underline; }

.input {
  background: var(--gray-light);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  /* 全项目输入框统一定高 72rpx（与 search-picker 触发框一致）。
     必须用 height——微信原生 input 不理 min-height，会一高一矮 */
  height: 72rpx;
  box-sizing: border-box;
}
.form-row { display: flex; gap: 16rpx; }
.form-row .field { flex: 1; }

/* ---------- 密码框 + 眼睛（点击查看 / 关闭明文） ---------- */
.pwd-wrap {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.pwd-wrap .pwd-input { flex: 1; margin-bottom: 0; padding-right: 80rpx; }
.pwd-eye {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 34rpx;
  opacity: 0.75;
}
.pwd-eye:active { opacity: 1; }

/* ---------- 下拉选择框 / 只读回显 ---------- */
.picker-view {
  color: var(--text);
  font-size: 32rpx;
  line-height: 1.4;
  padding: 16rpx 20rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.picker-view::after { content: ''; }
.readonly {
  background: #f3f4f6;
  color: var(--text-sub);
}
/* 只读框（view）用 flex 居中，与输入框/选择器视觉一致 */
.input.readonly { display: flex; align-items: center; }
.readonly-empty { color: #bbb; }

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #ffffff; }
.btn-ghost { background: #ffffff; color: var(--primary); border: 2rpx solid var(--primary); }
.btn-danger { background: var(--danger); color: #ffffff; }
.btn-ok { background: var(--ok); color: #ffffff; }
.btn-mini {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
  line-height: 1.4;
}
.btn-mini.primary { background: var(--primary); color: #fff; }
.btn-mini.ghost { background: #fff; color: var(--primary); border: 2rpx solid var(--primary); }
.btn-mini.danger { background: var(--danger); color: #fff; }
.btn-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-row .btn { flex: 1; }

/* ---------- 列表 ---------- */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--gray-light);
}
.list-item:last-child { border-bottom: none; }
.list-item-low { background: rgba(230, 67, 64, 0.06); position: relative; padding-left: 12rpx; }
.low-bar {
  position: absolute;
  left: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 6rpx;
  background: var(--danger);
  border-radius: 0 6rpx 6rpx 0;
}
.li-main { flex: 1; }
.li-title { font-size: 28rpx; font-weight: 500; }
.li-sub { font-size: 22rpx; color: var(--text-sub); margin-top: 4rpx; }
.li-spec { color: var(--gray); font-weight: 400; font-size: 24rpx; }
.li-right { text-align: right; margin-left: 16rpx; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  line-height: 1.5;
}
.tag.green { background: var(--ok-light); color: var(--ok); }
.tag.orange { background: var(--warn-light); color: var(--warn); }
.tag.red { background: var(--danger-light); color: var(--danger); }
.tag.gray { background: var(--gray-light); color: var(--gray); }
.tag.blue { background: #e7f0fb; color: #2c6bb0; }

/* ---------- 数量 ---------- */
.num { font-variant-numeric: tabular-nums; font-weight: 600; }
.num-pos { color: var(--ok); }
.num-neg { color: var(--danger); }
.num-zero { color: var(--gray); }

/* ---------- 空态 / 提示 ---------- */
.empty { text-align: center; color: var(--gray); font-size: 26rpx; padding: 48rpx 0; }
.hint { font-size: 22rpx; color: var(--text-sub); margin-top: 12rpx; }
.hint.err { color: var(--danger); }

/* ---------- 工作台宫格导航 ---------- */
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.grid-item {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.grid-item .gi-name { font-size: 26rpx; margin-top: 12rpx; display: block; }
.grid-item .gi-icon { font-size: 44rpx; }
/* 管理端 2 列大卡布局（v1.0.3 老板 2026-09-15 拍板：宫格更宽松） */
.grid-2col .grid-item { width: calc((100% - 20rpx) / 2); padding: 48rpx 0; }
.grid-2col .grid-item .gi-name { font-size: 30rpx; margin-top: 16rpx; }
/* 待处理角标（微信消息同款红气泡，钉在卡片右上角） */
.gi-badge {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: var(--danger, #e64340);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(230, 67, 64, 0.4);
}

/* ---------- 明细行（申请明细 / 菜品消耗清单编辑） ---------- */
/* 消耗行两段式：第一行食材选择器占满+删除；第二行两个半宽数量框 */
/* 行内所有框统一 72rpx 高（微信 input 原生高度偏矮，不拉齐会一高一矮） */
.ci-block { margin-bottom: 4rpx; }
.ci-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 8rpx; }
.ci-row .input, .ci-row picker { flex: 1; height: 72rpx; box-sizing: border-box; }
.ci-row .ci-picker { flex: 1; min-width: 0; }
.ci-row .del { color: var(--danger); font-size: 26rpx; padding: 12rpx 16rpx; flex-shrink: 0; }
.ci-sub { display: flex; gap: 12rpx; align-items: center; margin-bottom: 16rpx; }
.ci-sub .input { flex: 1; min-width: 0; height: 72rpx; box-sizing: border-box; }

/* ---------- 功能面板（首页宫格） / 子页返回栏 ---------- */
.grid-item.current { border: 3rpx solid var(--primary); }
.grid-item .gi-name { font-weight: 500; }
.backbar {
  display: block;
  text-align: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 0;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: var(--primary);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 首页顶栏（栈底页面：左角色、右退出登录） */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}
.topbar .tb-title { font-size: 28rpx; color: #666; }
.topbar .tb-action { font-size: 28rpx; color: var(--primary, #b03a2e); }

/* ---------- 居中弹层（全局：原本只在 search-picker 组件内，老板 21:50 反馈页面里直接用没效果） ----------
   弹层 .ip-mask / .ip-panel / .ip-header / .ip-search / .ip-search-input / .ip-search-clear
       / .ip-close / .ip-list / .ip-row / .ip-row-active / .ip-row-label / .ip-row-check / .ip-empty-row
       / .ip-title
   组件样式默认隔离，不能跨组件/页面用 → 必须放全局。 */
.ip-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ip-panel {
  width: 70%;
  max-height: 55vh;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.ip-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--gray-light);
  gap: 16rpx;
}
.ip-title { font-size: 32rpx; font-weight: 600; color: var(--text); flex: 1; }
.ip-search {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--gray-light);
  border-radius: 12rpx;
  padding: 0 16rpx;
  min-height: 72rpx;
}
.ip-search-input {
  flex: 1;
  font-size: 30rpx;
  padding: 16rpx 0;
  background: transparent;
}
.ip-search-clear {
  color: var(--gray);
  font-size: 36rpx;
  padding: 0 8rpx;
  line-height: 1;
}
.ip-close {
  color: var(--primary);
  font-size: 30rpx;
  padding: 8rpx 4rpx;
}
.ip-list {
  flex: 1;
  overflow-y: auto;
  padding: 12rpx 0;
}
.ip-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  line-height: 1.4;
  border-bottom: 2rpx solid var(--gray-light);
}
.ip-row:last-child { border-bottom: none; }
.ip-row-active { background: var(--primary-light); }
.ip-row-label { flex: 1; }
.ip-row-check {
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 500;
}
.ip-empty-row {
  padding: 60rpx 24rpx;
  text-align: center;
  color: var(--gray);
  font-size: 28rpx;
}

/* ==========================================================================
 * 导出文字按钮（管理端门店详情 ③ 历史消耗 + 门店端 ② 消耗 共用；v1.0.4 老板 2026-09-19）
 * 放在 tab 内容区最顶部、一行右对齐（小程序右上角原生胶囊改不了，故做在内容区）
 * ========================================================================== */
.ex-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.ex-btn {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 26rpx;
  color: var(--primary);
  padding: 6rpx 22rpx;
  border: 2rpx solid var(--primary);
  border-radius: 10rpx;
  line-height: 1.4;
}
.ex-btn:active { background: var(--primary-light); }
.ex-btn-disabled { color: var(--gray); border-color: var(--gray-light); }

/* ==========================================================================
 * 消耗记录时间范围筛选条（管理端门店详情 ③ + 门店端 ② 共用；老板 2026-09-19）
 * 一行：左侧范围胶囊（本周/本月/自定义/全部）+ 右侧导出；自定义档下方展开起止日期
 * ========================================================================== */
.fr-pills { display: flex; gap: 12rpx; flex: 1; }
.fr-pill {
  flex: 1;
  text-align: center;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: var(--gray);
  background: var(--gray-light);
  border-radius: 10rpx;
}
.fr-pill-active { background: var(--primary); color: #ffffff; font-weight: 600; }
.fr-dates { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.fr-date-label { font-size: 24rpx; color: var(--text-sub); }
.fr-date { flex: 1; }

/* ==========================================================================
 * 消耗汇总页（管理端 / 门店端共用；v1.0.4 老板 2026-09-19）
 * 时间范围胶囊 + 门店选择 + 维度切换 + 汇总列表（就地展开明细）
 * ========================================================================== */
.cs-range { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.cs-pill {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--gray);
  background: var(--gray-light);
  border-radius: 12rpx;
}
.cs-pill-active { background: var(--primary); color: #ffffff; font-weight: 600; }
.cs-picker { display: block; margin-bottom: 16rpx; }
.cs-picker-view { display: flex; align-items: center; justify-content: space-between; }
.cs-caret { color: var(--gray); font-size: 24rpx; }
/* 维度切换沿用 .rq-tabs 观感（此处提供全局定义，页面可直接引用） */
.rq-tabs { display: flex; gap: 16rpx; }
.rq-tab {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--gray-light);
  color: var(--gray);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.rq-tab-active {
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(176, 58, 46, 0.25);
}
.cs-row { align-items: center; }
.cs-right { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; }
.cs-arrow { color: var(--gray); font-size: 24rpx; }
.cs-detail {
  background: var(--gray-light);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  margin: 8rpx 0 16rpx;
}
.cs-detail-empty { color: var(--gray); font-size: 24rpx; padding: 8rpx 0; }
.cs-detail-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #e6e3dc;
}
.cs-detail-line:last-child { border-bottom: none; }
.cs-detail-name { font-size: 26rpx; color: var(--text); }
.cs-detail-val { font-size: 26rpx; color: var(--primary); font-weight: 600; }
.cs-detail-sub { font-size: 22rpx; color: var(--gray); font-weight: 400; margin-left: 12rpx; }

/* ==========================================================================
 * 列表检索条（老板 2026-10 拍板：「每个列表页面都要增加一个检索功能，快速定位商品」）
 * 全站一套类名，11 处列表页共用；纯本地过滤（输入即出结果，不调云函数）
 *   .searchbar / .searchbar-box / .searchbar-input / .searchbar-clear / .searchbar-empty
 * ========================================================================== */
.searchbar { margin-bottom: 12rpx; }
.searchbar-box {
  display: flex;
  align-items: center;
  background: var(--gray-light);
  border-radius: 12rpx;
  padding: 0 16rpx;
  /* 原生 input 不理 min-height，必须用 height（全项目输入框统一 72rpx） */
  height: 72rpx;
}
.searchbar-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: var(--text);
  background: transparent;
}
.searchbar-clear {
  flex-shrink: 0;
  color: var(--gray);
  font-size: 32rpx;
  line-height: 1;
  padding: 0 8rpx;
}
.searchbar-empty {
  text-align: center;
  color: var(--gray);
  font-size: 26rpx;
  padding: 32rpx 0;
}
